{
  "compilerOptions": {
    "jsx": "react-jsx",   // O usa "react" dependiendo de tu versión de React
    "allowJs": true,      // Acepta archivos .js y .jsx en el proyecto
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/renderer/src/*"]
    },
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
