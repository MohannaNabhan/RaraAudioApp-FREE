{
  "name": "RaraAudioApp",
  "version": "2.0.23",
  "description": "RaraAudioApp",
  "main": "./out/main/index.js",
  "author": "RaraAudioApp.com",
  "homepage": "https://RaraAudioApp.com/",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "css": "tailwindcss -i ./input.style.css -o ./src/renderer/src/assets/output.css --watch",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "RaraAudioApp.com",
    "productName": "RaraAudioApp.com",
    "files": [
      "!**/.vscode/*",
      "!src/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}",
      "!{.env,.env.*,.npmrc,pnpm-lock.yaml}",
      "!tailwind.config.js",
      "!tsconfig.json",
      "!postcss.config",
      "!components.json",
      "!input.style.css",
      "!postcss.config.js",
      "!dist/*",
      "!certificate.p12"
    ],
    "win": {
      "icon": "./src/icon.ico",
      "target": [
        "nsis"
      ],
      "publisherName": "RaraAudioApp.com",
      "requestedExecutionLevel": "requireAdministrator",
      "certificateFile": "./certificate.p12",
      "certificatePassword": "5LcT4Ym75b1jPpSCUzCwjmVxgvh",
      "signAndEditExecutable": true
    },
    "nsis": {
      "installerIcon": "./src/icon.ico",
      "uninstallerIcon": "./src/icon.ico",
      "artifactName": "${name}.${ext}",
      "shortcutName": "RaraAudioApp",
      "uninstallDisplayName": "RaraAudioApp",
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.1",
    "@electron-toolkit/utils": "3.0.0",
    "@fontsource-variable/montserrat": "^5.1.1",
    "@fontsource/poppins": "5.1.0",
    "adm-zip": "0.5.16",
    "cors": "2.8.5",
    "discord-rpc": "^4.0.1",
    "hwid": "0.5.0",
    "path-to-regexp": "8.2.0",
    "socket.io-client": "4.8.1",
    "string-similarity": "4.0.4",
    "unzipper": "0.12.3",
    "voicemeeter-remote": "0.5.0",
    "winreg": "1.2.5",
    "xml-js": "1.6.11",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "1.0.2",
    "@electron-toolkit/eslint-config-prettier": "2.0.0",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "29.1.6",
    "electron-builder": "24.13.3",
    "electron-vite": "2.3.0",
    "eslint": "8.57.0",
    "eslint-plugin-react": "7.34.3",
    "prettier": "3.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.14",
    "vite": "5.3.1"
  }
}
